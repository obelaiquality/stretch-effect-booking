        {
            "name": "add_session_credits",
            "title": "Add session credits",
            "description": "Add 1-20 sessions to a client after they have paid. Needs a reason and a unique idempotency_key. At most 40 sessions can be added per day through ChatGPT.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "client_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "sessions": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Why, for example \"paid EFT for 5-pack\"."
                    },
                    "payment_reference": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 60,
                        "description": "Optional payment reference: 3 to 60 characters, letters, digits, spaces and . _ / # - only. Each reference can be used once, ever (case and spacing are ignored)."
                    },
                    "idempotency_key": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "A unique key (8-64 letters, digits, - or _) for this change. Repeating the same key never applies the change twice."
                    }
                },
                "required": [
                    "client_id",
                    "sessions",
                    "reason",
                    "idempotency_key"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "title": "Add session credits",
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            },
            "securitySchemes": [
                {
                    "type": "oauth2",
                    "scopes": [
                        "credits:write"
                    ]
                }
            ],
            "_meta": {
                "securitySchemes": [
                    {
                        "type": "oauth2",
                        "scopes": [
                            "credits:write"
                        ]
                    }
                ]
            }
        },
