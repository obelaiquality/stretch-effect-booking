                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "idempotency_key": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "A unique key (8-64 letters, digits, - or _) for this change. Repeating the same key never applies the change twice."
                    }
                },
                "required": [
                    "client_id",
                    "sessions",
                    "reason",
                    "idempotency_key"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "title": "Remove session credits",
                "readOnlyHint": false,
                "destructiveHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            },
            "securitySchemes": [
                {
                    "type": "oauth2",
                    "scopes": [
                        "credits:write"
                    ]
                }
