{
  "name": "obel/stretch-effect-server",
  "description": "The Stretch Effect booking backend (no runtime dependencies; Composer is for tests only)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "infection/infection": "^0.35.10",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "StretchEffect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StretchEffect\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite=server",
    "fuzz": "phpunit --testsuite=fuzz",
    "mutation": "infection --threads=4 --with-uncovered --only-covering-test-cases --no-progress"
  },
  "config": {
    "sort-packages": true,
    "platform-check": false,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
